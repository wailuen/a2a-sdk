# Copy to .env. Never invent MASTER_KEY — generate it (>=32 random chars).

AGENT_NAME=alphageo-climate-analyst
PORT=8045

# REQUIRED outside DEV_MODE. Every advertised URL derives from this.
PUBLIC_URL=

# >=32 chars, generated. Encrypts the credential store (AES-256-GCM).
MASTER_KEY=

# DEV_MODE relaxes MASTER_KEY strength, the PUBLIC_URL requirement, and
# secure-transport checks on OAuth endpoints. Never true on a public URL.
DEV_MODE=false

# ── Model provider (this agent runs on the OpenAI ModelClient seam) ──
# Vanilla OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional reasoning-model knobs:
# OPENAI_REASONING_EFFORT=medium
# OPENAI_MAX_COMPLETION_TOKENS=

# ── OR Azure OpenAI (takes precedence when endpoint + key are both set) ──
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=mcp-alphageo

# ── AlphaGeo upstream ──
ALPHAGEO_BASE_URL=https://app.alphageo.ai/api/public/v1
# The AlphaGeo API key is NOT set here. It is supplied at runtime — either
# stored per-identity in the admin console, or forwarded per request by the
# client via the X-Agent-Credentials header (credential-forwarding extension).

# Explicit list, never a wildcard.
CORS_ORIGINS=["https://claude.ai"]

DATA_DIR=/data
